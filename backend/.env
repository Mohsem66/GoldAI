# ============================================================
# فایل .env - تنظیمات محیطی
# ============================================================

# سرور
PORT=3000
NODE_ENV=development

# API Keys (برای نسخه واقعی)
# FRED_API_KEY=your_fred_api_key_here
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# NEWS_API_KEY=your_news_api_key_here

# تنظیمات پایگاه داده (در صورت نیاز)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=goldai
# DB_USER=postgres
# DB_PASSWORD=your_password

# تنظیمات Redis (برای Cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# تنظیمات لاگ
LOG_LEVEL=info
LOG_FILE=logs/app.log

# تنظیمات امنیت
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# تنظیمات معاملاتی (پیش‌فرض)
TRADING_MAX_POSITIONS=3
TRADING_RISK_PER_TRADE=0.02
TRADING_STOP_LOSS=0.015
TRADING_TAKE_PROFIT=0.03
TRADING_SPREAD=0.0003
TRADING_SLIPPAGE=0.0001

# غیرفعال کردن لایه‌ها
DISABLE_FUNDAMENTAL=true
DISABLE_CORRELATION=true

# تنظیمات AI
AI_MODEL=ensemble
AI_LOOKBACK=50

# تنظیمات News
NEWS_ENABLED=true
NEWS_WEIGHT=0.15
